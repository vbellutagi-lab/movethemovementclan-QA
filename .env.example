# Point these at a running instance of movethemovementclan (default: local `pnpm dev`
# against the docker-compose stack in that repo — Postgres on 5434, Mailpit on 8025).
# This QA suite is fully black-box: it never imports app source or touches the database
# directly, only HTTP (api-client, better-auth REST) and the browser (Playwright).
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000

# Mailpit web UI — used by e2e tests that need to read a verification/reset/invitation email.
MAILPIT_BASE_URL=http://localhost:8025

# Seeded dev identities (apps/api/src/scripts/seed). Do not point this suite at anything
# that isn't disposable dev/test data — several scenarios are deliberately destructive
# (credit reversal, cancellations, role/session abuse).
SEED_PASSWORD=ChangeMe123!
SEED_ORG_SLUG=move-dev
