{
  "name": "movethemovementclan-qa",
  "version": "1.0.0",
  "private": true,
  "description": "Black-box QA automation (integration + e2e + adversarial/security) for movethemovementclan, driven purely over HTTP/browser against a running instance.",
  "type": "module",
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:security": "vitest run --config vitest.config.ts src/integration/security",
    "test:regression": "QA_AUTOWAIT_RATE_LIMIT=true vitest run --config vitest.regression.config.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium",
    "regression": "node scripts/run-regression.mjs",
    "diff:since-tag": "node scripts/diff-since-tag.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.10.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "zod": "^3.23.0"
  }
}
